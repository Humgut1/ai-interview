# 실제 키는 .env.local 에 넣으세요. .env.local 은 git 에 올라가지 않습니다.
# 이 파일에는 값 없이 항목 이름만 둡니다.

# Supabase — Hire 와 같은 프로젝트, 표 이름은 screen_ 으로 시작 (supabase/screen-001-tables.sql)
# 서버에서만 쓰므로 NEXT_PUBLIC_ 이름을 쓰지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (질문 초안 생성, 채점 — SC2). 사용자가 Vercel 에 직접 넣는다.
ANTHROPIC_API_KEY=
